{
  // 纯逻辑模块的类型检查 (tsc --checkJs): gcj02 / trackutil / format /
  // trip-playback (Tesla) / lastpage / bookkeeping-merge (记账同步纯逻辑) /
  // lyrics-parser + player-queue + downloads + cellular-usage (音乐, 在 js/ 子目录)。页面脚本 (trips.js 等) 依赖
  // 高德/echarts 宿主对象, 类型声明成本高, 由 ESLint 把关。
  // types:[] — 不自动引入 node_modules/@types (共享目录里有别的包声明)
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2020",
    "lib": ["dom", "es2020"],
    "types": []
  },
  "include": [
    "app/tesla/static/gcj02.js",
    "app/tesla/static/trackutil.js",
    "app/tesla/static/format.js",
    "app/tesla/static/trip-playback.js",
    "app/tesla/static/lastpage.js",
    "app/bookkeeping/static/bookkeeping-merge.js",
    "app/music/static/js/lyrics-parser.js",
    "app/music/static/js/player-queue.js",
    "app/music/static/js/downloads.js",
    "app/music/static/js/downloads-capability.js",
    "app/music/static/js/cellular-usage.js",
    "frontend-globals.d.ts"
  ]
}
