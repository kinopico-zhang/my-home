# 复制为 .env 并填写; .env 已被 git 忽略
#
# 首启必填: 管理员密码 (第一次启动种 admin 进账号库; 已有账号库
# data/users.db 的话不受影响 —— 只在空库时种)
AUTH_PASS=
# AUTH_USER=admin

# 高德开放平台 (个人开发者免费): https://console.amap.com/dev/key/app
# Key 的服务平台必须选「Web端 (JS API)」, 安全密钥在 Key 详情页
AMAP_KEY=
AMAP_SECURITY_CODE=

# 以下都是首启默认值 —— 存库后以设置页 (/tesla/settings) 里保存的为准,
# 未在设置页填过的字段才回落到这里 (主机没配时再自动定位 docker 容器)
# TMDB_HOST=
# TMDB_PORT=5432
# TMDB_USER=teslamate
# TMDB_PASS=123456
# TMDB_NAME=teslamate

# 曲库根目录 (My Music 首扫从这里开始)
# MYTESLA_MUSIC_DIR=/share/Media/Music

# 可选: 服务端口
# PORT=8500

# 四份库文件默认都在 data/ 下 (users / music / bookkeeping / mytesla),
# 会话密钥默认在仓库根 .session_secret —— 一般都不用改
# MYHOME_USERS_DB=data/users.db
# MYHOME_SECRET_FILE=.session_secret
# MYTESLA_MUSIC_DB=sqlite:///data/music.db
# MYTESLA_BOOKKEEPING_DB=sqlite:///data/bookkeeping.db
# MYTESLA_DB=sqlite:///data/mytesla.db
